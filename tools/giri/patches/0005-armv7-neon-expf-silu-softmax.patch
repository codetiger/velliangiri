+// cases selected without a branch (a NEON->ARM transfer stalls this core),
+// and divisions done as a reciprocal estimate refined by two Newton steps.
+inline static float32x4_t ggml_v_expf(float32x4_t x) {
+    const float32x4_t r = vdupq_n_f32(0x1.8p23f);
+    const float32x4_t z = vmlaq_f32(r, x, vdupq_n_f32(0x1.715476p+0f));
