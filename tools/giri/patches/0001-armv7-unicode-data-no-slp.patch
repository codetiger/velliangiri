--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -59,6 +59,13 @@
     UNITY_BUILD_BATCH_SIZE 16
 )
 
+# GCC 13 on ARMv7 vectorises the large static tables in unicode-data.cpp into
+# vldr loads whose literal pool is out of range; keep SLP off for that file.
+if (CMAKE_SYSTEM_PROCESSOR MATCHES "^armv7")
+    set_source_files_properties(unicode-data.cpp PROPERTIES
+        COMPILE_OPTIONS "-fno-tree-slp-vectorize")
+endif()
+
 # exclude non-model sources from unity build
 set_source_files_properties(${LLAMA_CORE_SOURCES} ../include/llama.h unicode.h
     PROPERTIES SKIP_UNITY_BUILD_INCLUSION ON)
