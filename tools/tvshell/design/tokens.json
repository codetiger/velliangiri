{
  "$license": "GPL-2.0-only",
  "$description": "Design tokens for the TV shell. All sizes are pixels on the 1280x720 framebuffer; colours are sRGB hex for XRGB8888 scanout.",

  "screen": {
    "width": 1280,
    "height": 720,
    "safeX": 64,
    "safeY": 36,
    "contentLeft": 96,
    "contentRight": 96,
    "contentTop": 40,
    "contentBottom": 52,
    "contentMaxWidth": 1088,
    "textMaxWidth": 1000
  },

  "themes": {
    "paper": {
      "font": { "family": "Literata", "regular": 400, "bold": 600, "fallback": "serif" },
      "radius": 6,
      "answerLineHeight": 1.45,
      "stateIndicator": ["logo"],
      "color": {
        "ground": "#F2EDE3",
        "text": "#1E1A15",
        "choice": "#1E1A15",
        "secondary": "#675E53",
        "rule": "#D6CDBE",
        "focus": "#1E1A15",
        "onFocus": "#F2EDE3",
        "onFocusSecondary": "#D6CDBE",
        "badge": "#1E1A15",
        "onBadge": "#F2EDE3",
        "accent": "#F59E0B"
      },
      "logo": { "ready": "logo/logo-paper.svg", "working": "logo/logo-paper-working.svg" }
    },
    "signal": {
      "font": { "family": "Atkinson Hyperlegible", "regular": 400, "bold": 700, "fallback": "sans-serif" },
      "radius": 8,
      "answerLineHeight": 1.5,
      "stateIndicator": ["logo", "line"],
      "color": {
        "ground": "#0C0D10",
        "text": "#E9E7E2",
        "choice": "#A9AEB6",
        "item": "#C9CCD2",
        "secondary": "#8B9099",
        "rule": "#2C3038",
        "focus": "#F1EFEA",
        "onFocus": "#0C0D10",
        "onFocusSecondary": "#4A4F57",
        "badge": "#0C0D10",
        "onBadge": "#E9E7E2",
        "accent": "#F59E0B",
        "stateLineIdle": "#2C3038",
        "stateLineTrack": "#1C1F25"
      },
      "logo": { "ready": "logo/logo-signal.svg", "working": "logo/logo-signal-working.svg" },
      "stateLine": { "idleHeight": 3, "workingHeight": 6 }
    }
  },

  "type": {
    "display": 64,
    "askInput": 44,
    "answer": 34,
    "item": 28,
    "step": 28,
    "choice": 26,
    "question": 24,
    "tileTitle": 24,
    "itemDetail": 22,
    "meta": 20,
    "tileDetail": 18,
    "badge": 16
  },

  "space": {
    "headerGap": 20,
    "ruleAbove": 18,
    "ruleBelow": 34,
    "answerToSources": 26,
    "answerToItems": 18,
    "answerToTiles": 30,
    "choiceGap": 12,
    "choicePadY": 12,
    "choicePadX": 20,
    "itemPadY": 9,
    "itemPadX": 20,
    "stepGap": 18,
    "tileGap": 24,
    "symbolGap": 12
  },

  "logo": {
    "width": 49,
    "height": 40,
    "viewBox": "26 62 460 380",
    "clearSpace": 12,
    "position": "top-left of the content box, vertically centred on the question line"
  },

  "symbols": {
    "size": 24,
    "strokeWidth": 2,
    "colour": "currentColor; the renderer rasterizes each as an alpha mask and tints it",
    "files": {
      "check": "symbols/check.svg",
      "play": "symbols/play.svg",
      "page": "symbols/page.svg",
      "folder": "symbols/folder.svg",
      "game": "symbols/game.svg",
      "keyboard": "symbols/keyboard.svg"
    }
  },

  "thumbnail": {
    "width": 248,
    "height": 140,
    "perRow": 4,
    "focusFrame": 4,
    "focusOffset": 4,
    "cache": "nand0p2:/linux/cache/thumbs, keyed by path + mtime"
  },

  "limits": {
    "answerLines": 8,
    "items": 5,
    "tiles": 4,
    "llmChoices": 3,
    "choiceLabelChars": 24,
    "questionLines": 1
  },

  "timing": {
    "logoBlinkMs": 500,
    "viewerOverlayHideMs": 2000,
    "menuHoldMs": 2000
  }
}
