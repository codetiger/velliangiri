{
  "name": "Giri on Velliangiri OS — TV UI Design Tokens",
  "version": "1.2.0",
  "license": "GPL-2.0-only",
  "identity": {
    "assistant": "Giri",
    "os": "Velliangiri OS",
    "schemas": {
      "screen": "screen.schema.json",
      "tool": "tool.schema.json",
      "models": "supported_models.json"
    }
  },
  "target": {
    "resolution": { "width": 1280, "height": 720, "aspect": "16:9" },
    "safeArea": { "top": 36, "right": 64, "bottom": 36, "left": 64 },
    "usableCanvas": { "width": 1152, "height": 648 },
    "viewingDistanceMeters": 3.0,
    "framebuffer": {
      "format": "XRGB8888",
      "bytesPerPixel": 4,
      "gammaLutBypassed": true,
      "dithering": "4x4 Bayer ordered dithering on 16x16 subpixel rasterizer"
    }
  },
  "themes": {
    "paper": {
      "label": "Paper (Default — Warm Daylight)",
      "bg": "#F2EDE3",
      "surface": "#E7E0D3",
      "surfaceHi": "#EFEAE0",
      "ink": "#161513",
      "muted": "#57534E",
      "border": "#CFC7B8",
      "accent": "#D97706",
      "focusRing": "#D97706",
      "focusGlow": "rgba(245, 158, 11, 0.28)",
      "cardBg": "#12151C",
      "btnBg": "#E6DFD1",
      "btnFocusBg": "#FFFDF9"
    },
    "signal": {
      "label": "Signal (Dark Room / Night)",
      "bg": "#0C0D10",
      "surface": "#15181E",
      "surfaceHi": "#1C2028",
      "ink": "#F2EFE9",
      "muted": "#9CA3AF",
      "border": "#2B303C",
      "accent": "#F59E0B",
      "focusRing": "#F59E0B",
      "focusGlow": "rgba(245, 158, 11, 0.28)",
      "cardBg": "#12151C",
      "btnBg": "#171B22",
      "btnFocusBg": "#232936"
    }
  },
  "logo": {
    "viewBox": "26 62 460 380",
    "headerSize": { "width": 49, "height": 40 },
    "rendering": "10 linear gradients across 3D mountain facets (outer ridges, dark hills, silver glacier, and golden summit)",
    "animationFrames": [
      { "step": 0, "state": "ready",   "fillOpacity": 1.00, "facetScale": 1.00, "strokeWidth": 0,  "horizonOpacity": 0.80 },
      { "step": 1, "state": "frame_1", "fillOpacity": 0.75, "facetScale": 0.95, "strokeWidth": 8,  "horizonOpacity": 0.60 },
      { "step": 2, "state": "frame_2", "fillOpacity": 0.48, "facetScale": 0.90, "strokeWidth": 14, "horizonOpacity": 0.35 },
      { "step": 3, "state": "frame_3", "fillOpacity": 0.22, "facetScale": 0.86, "strokeWidth": 18, "horizonOpacity": 0.15 },
      { "step": 4, "state": "working", "fillOpacity": 0.00, "facetScale": 0.82, "strokeWidth": 20, "horizonOpacity": 0.00 }
    ],
    "pingPongSequence": [0, 1, 2, 3, 4, 3, 2, 1],
    "frameIntervalMs": 65
  },
  "typography": {
    "families": {
      "sans": ["Plus Jakarta Sans", "-apple-system", "BlinkMacSystemFont", "sans-serif"],
      "mono": ["JetBrains Mono", "ui-monospace", "SFMono-Regular", "monospace"]
    },
    "scale": {
      "headerBrand":    { "size": 22, "weight": 700, "tracking": -0.02 },
      "headerPrompt":   { "size": 20, "weight": 600, "tracking": 0     },
      "summaryTitle":   { "size": 21, "weight": 700, "lineHeight": 1.22, "tracking": -0.02 },
      "summaryText":    { "size": 18, "weight": 500, "lineHeight": 1.42, "tracking": 0     },
      "summarySource":  { "size": 12.5, "weight": 500, "family": "mono" },
      "cardTitle":      { "size": 16.5, "weight": 700, "lineHeight": 1.22 },
      "cardSubtitle":   { "size": 13, "weight": 500, "lineHeight": 1.28 },
      "cardBadge":      { "size": 11, "weight": 600, "family": "mono" },
      "footerBtnLabel": { "size": 14, "weight": 600, "lineHeight": 1.22 },
      "overlayTitle":   { "size": 28, "weight": 700, "lineHeight": 1.20 },
      "overlayText":    { "size": 18, "weight": 500, "lineHeight": 1.44 }
    }
  },
  "characterBudgets": {
    "headerPromptTitle": 56,
    "summaryTitle": 64,
    "summaryText": 250,
    "summarySourceCaption": 48,
    "mediaCardTitle": 26,
    "mediaCardSubtitle": 38,
    "mediaCardBadge": 10,
    "mediaCardMetaPill": 8,
    "footerLinkLabel": 42,
    "allowEllipsis": false
  },
  "layout": {
    "slots": {
      "headerHeight": 44,
      "summaryBoxHeight": 148,
      "mediaCardsRowHeight": 312,
      "footerBarHeight": 58,
      "verticalGap": 28
    },
    "mediaCards": {
      "columns": 4,
      "gap": 18,
      "cardWidth": 274.5,
      "cardHeight": 312,
      "radius": 14,
      "fullBleedImageWithOverlay": true
    },
    "footerBar": {
      "gridTemplateColumns": "188px 1fr 1fr 188px",
      "gap": 16,
      "height": 58,
      "radius": 12,
      "fixedLeft": "Ask Giri",
      "fixedRight": "Settings"
    },
    "borders": {
      "rule": "Borders are strictly shown ONLY on selectable elements (.media-card, .footer-btn, .setting-row, .quick-chip, .overlay-hint). Non-selectable containers have border: none.",
      "defaultWidthPx": 2,
      "focusedWidthPx": 3
    }
  }
}
