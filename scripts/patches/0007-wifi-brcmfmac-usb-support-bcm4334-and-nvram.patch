 	struct brcmf_bus *bus = dev_get_drvdata(dev);
 	struct brcmf_usbdev_info *devinfo = bus->bus_priv.usb->devinfo;
 	const struct firmware *fw;
+	void *nvram;
+	u32 nvram_len;
+	u8 *image = NULL;
 
 	if (ret)
 		goto error;
@@ -1180,19 +1261,32 @@ static void brcmf_usb_probe_phase2(struct device *dev, int ret,
 	brcmf_dbg(USB, "Start fw downloading\n");
 
 	fw = fwreq->items[BRCMF_USB_FW_CODE].binary;
+	nvram = fwreq->items[BRCMF_USB_FW_NVRAM].nv_data.data;
+	nvram_len = fwreq->items[BRCMF_USB_FW_NVRAM].nv_data.len;
+	devinfo->clm_fw = fwreq->items[BRCMF_USB_FW_CLM].binary;
 	kfree(fwreq);
 
 	ret = check_file(fw->data);
 	if (ret < 0) {
 		brcmf_err("invalid firmware\n");
 		release_firmware(fw);
+		brcmf_fw_nvram_free(nvram);
 		goto error;
 	}
 
 	devinfo->image = fw->data;
 	devinfo->image_len = fw->size;
+	if (nvram) {
+		image = brcmf_usb_trx_add_nvram(fw, ret, nvram, nvram_len,
+						&devinfo->image_len);
+		if (image)
+			devinfo->image = image;
+		brcmf_fw_nvram_free(nvram);
+	}
 
 	ret = brcmf_usb_fw_download(devinfo);
+	devinfo->image = NULL;
+	kfree(image);
 	release_firmware(fw);
 	if (ret)
 		goto error;
@@ -1206,10 +1300,14 @@ static void brcmf_usb_probe_phase2(struct device *dev, int ret,
 	if (ret)
 		goto error;
 
+	release_firmware(devinfo->clm_fw);
+	devinfo->clm_fw = NULL;
 	complete(&devinfo->dev_init_done);
 	return;
 error:
 	brcmf_dbg(TRACE, "failed: dev=%s, err=%d\n", dev_name(dev), ret);
+	release_firmware(devinfo->clm_fw);
+	devinfo->clm_fw = NULL;
 	complete(&devinfo->dev_init_done);
 	device_release_driver(dev);
 }
