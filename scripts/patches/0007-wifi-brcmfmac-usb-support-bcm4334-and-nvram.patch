 #define BRCMF_USB_FW_CODE	0
+#define BRCMF_USB_FW_NVRAM	1
+#define BRCMF_USB_FW_CLM	2
+
+/*
+ * Append the NVRAM variables to a TRX image so the boot loader places them
+ * with the firmware. Any padding after the firmware part (header plus
+ * offsets[0] bytes) is dropped and the NVRAM takes its place; the header
+ * records the NVRAM length and its CRC is recomputed over the new image,
+ * keeping whether the original stored the running CRC or its complement.
+ * Returns a new buffer the caller frees, or NULL to download the image
+ * unchanged.
+ */
+static u8 *brcmf_usb_trx_add_nvram(const struct firmware *fw, int fwlen,
+				   const void *nvram, u32 nvram_len,
+				   int *image_len)
+{
+	const struct trx_header_le *trx = (const void *)fw->data;
+	struct trx_header_le *hdr;
+	size_t crc_off = offsetof(struct trx_header_le, flag_version);
+	u32 len = le32_to_cpu(trx->len);
+	u32 crc, inv;
+	u8 *image;
+
+	if (trx->offsets[TRX_OFFSETS_NVM_LEN_IDX]) {
+		brcmf_dbg(USB, "image already carries NVRAM\n");
+		return NULL;
+	}
+	if (len < fwlen || len > fw->size) {
+		brcmf_err("unexpected TRX layout, NVRAM not appended\n");
+		return NULL;
+	}
+	crc = crc32_le(~0, fw->data + crc_off, len - crc_off);
+	if (crc == le32_to_cpu(trx->crc32)) {
+		inv = 0;
+	} else if (~crc == le32_to_cpu(trx->crc32)) {
+		inv = ~0;
+	} else {
+		brcmf_err("TRX CRC mismatch, NVRAM not appended\n");
+		return NULL;
+	}
+
+	image = kmalloc(fwlen + nvram_len, GFP_KERNEL);
+	if (!image)
+		return NULL;
+	memcpy(image, fw->data, fwlen);
+	memcpy(image + fwlen, nvram, nvram_len);
+
+	hdr = (struct trx_header_le *)image;
+	hdr->len = cpu_to_le32(fwlen + nvram_len);
+	hdr->offsets[TRX_OFFSETS_NVM_LEN_IDX] = cpu_to_le32(nvram_len);
+	crc = crc32_le(~0, image + crc_off, fwlen + nvram_len - crc_off);
+	hdr->crc32 = cpu_to_le32(crc ^ inv);
+
+	*image_len = fwlen + nvram_len;
+	return image;
+}
 
