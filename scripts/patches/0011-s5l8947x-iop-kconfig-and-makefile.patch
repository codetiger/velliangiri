diff --git a/drivers/soc/apple/Kconfig b/drivers/soc/apple/Kconfig
--- a/drivers/soc/apple/Kconfig
+++ b/drivers/soc/apple/Kconfig
@@ -62,6 +62,17 @@ config APPLE_S5L8947X_VXD
 	  its firmware and waits for the microkernel handshake. There is
 	  no decode interface yet.
 
+config APPLE_S5L8947X_IOP
+	tristate "S5L8947X IOP coprocessor power and firmware load"
+	depends on ARCH_APPLE_S5L || COMPILE_TEST
+	depends on COMMON_CLK
+	default ARCH_APPLE_S5L
+	help
+	  Brings up the S5L8947X IOP coprocessor: enables its clock gate,
+	  patches and loads the firmware carved from the device's own
+	  kernel image and starts the CPU. There is no message-channel
+	  client yet.
+
 endmenu
 
 endif
diff --git a/drivers/soc/apple/Makefile b/drivers/soc/apple/Makefile
--- a/drivers/soc/apple/Makefile
+++ b/drivers/soc/apple/Makefile
@@ -15,3 +15,4 @@
 apple-tunable-y = tunable.o
 
 obj-$(CONFIG_APPLE_S5L8947X_VXD) += s5l8947x-vxd.o
+obj-$(CONFIG_APPLE_S5L8947X_IOP) += s5l8947x-iop.o
