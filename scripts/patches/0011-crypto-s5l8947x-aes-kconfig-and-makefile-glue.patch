crypto: hook up the S5L8947X AES engine driver

Add the Kconfig symbol and Makefile line for the S5L8947X AES engine
driver copied in by apply-kernel-tree.py.
---
 drivers/crypto/Kconfig  | 11 +++++++++++
 drivers/crypto/Makefile |  1 +
 2 files changed, 12 insertions(+)

diff --git a/drivers/crypto/Kconfig b/drivers/crypto/Kconfig
--- a/drivers/crypto/Kconfig
+++ b/drivers/crypto/Kconfig
@@ -345,6 +345,17 @@
 
 endif # CRYPTO_DEV_OMAP
 
+config CRYPTO_DEV_S5L8947X_AES
+	tristate "S5L8947X AES engine"
+	depends on ARCH_APPLE_S5L || COMPILE_TEST
+	depends on OF && HAS_DMA && S5L8947X_CDMA
+	select CRYPTO_SKCIPHER
+	select CRYPTO_LIB_AES
+	help
+	  The memory-to-memory AES engine in the central DMA block of the
+	  S5L8947X SoC: ecb(aes) and cbc(aes) with user keys, and an
+	  in-kernel interface to the hardware keys held by the engine.
+
 config CRYPTO_DEV_SAHARA
 	tristate "Support for SAHARA crypto accelerator"
 	depends on ARCH_MXC && OF
diff --git a/drivers/crypto/Makefile b/drivers/crypto/Makefile
--- a/drivers/crypto/Makefile
+++ b/drivers/crypto/Makefile
@@ -37,6 +37,7 @@
 obj-$(CONFIG_CRYPTO_DEV_ROCKCHIP) += rockchip/
 obj-$(CONFIG_CRYPTO_DEV_S5P) += s5p-sss.o
 obj-$(CONFIG_CRYPTO_DEV_SA2UL) += sa2ul.o
+obj-$(CONFIG_CRYPTO_DEV_S5L8947X_AES) += s5l8947x-aes.o
 obj-$(CONFIG_CRYPTO_DEV_SAHARA) += sahara.o
 obj-$(CONFIG_CRYPTO_DEV_SL3516) += gemini/
 obj-y += stm32/
