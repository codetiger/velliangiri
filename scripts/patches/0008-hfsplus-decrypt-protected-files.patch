+static void hfsplus_init_file_crypt(struct inode *inode)
+{
+	struct hfsplus_inode_info *hip = HFSPLUS_I(inode);
+	u8 attr[128];
+	ssize_t res;
+
+	if (!S_ISREG(inode->i_mode) || HFSPLUS_IS_RSRC(inode) ||
+	    hip->file_crypt)
+		return;
+
+	res = __hfsplus_getxattr(inode, "com.apple.system.cprotect",
+				 attr, sizeof(attr));
+	if (res > 0) {
+		if (!s5l8947x_file_key_unwrap(attr, res, hip->file_key,
+					      hip->file_iv_key))
+			hip->file_crypt = 1;
+		else
+			hip->file_crypt = -2;
+	} else {
+		hip->file_crypt = -1;
+	}
+	memzero_explicit(attr, sizeof(attr));
+}
+
 static int hfsplus_read_folio(struct file *file, struct folio *folio)
 {
-	return block_read_full_folio(folio, hfsplus_get_block);
+	struct inode *inode = folio->mapping->host;
+	struct hfsplus_inode_info *hip = HFSPLUS_I(inode);
+	struct super_block *sb = inode->i_sb;
+	struct buffer_head bh = {};
+	loff_t pos = folio_pos(folio);
+	loff_t size = i_size_read(inode);
+	size_t valid;
+	u8 *dst;
+	int err;
+
+	if (hip->file_crypt != 1 || sb->s_blocksize != PAGE_SIZE ||
+	    folio_size(folio) != PAGE_SIZE)
+		return block_read_full_folio(folio, hfsplus_get_block);
+
+	if (pos >= size) {
+		folio_zero_range(folio, 0, PAGE_SIZE);
+		folio_mark_uptodate(folio);
+		folio_unlock(folio);
+		return 0;
+	}
+
+	bh.b_size = PAGE_SIZE;
+	err = hfsplus_get_block(inode, folio->index, &bh, 0);
+	if (err)
+		goto out_unlock;
+	if (!buffer_mapped(&bh)) {
+		folio_zero_range(folio, 0, PAGE_SIZE);
+		folio_mark_uptodate(folio);
+		folio_unlock(folio);
+		return 0;
+	}
+
+	dst = kmap_local_folio(folio, 0);
+	err = s5l8947x_file_block_decrypt(sb->s_bdev, bh.b_blocknr,
+					  hip->file_key, hip->file_iv_key,
+					  pos, dst);
+	valid = min_t(loff_t, PAGE_SIZE, size - pos);
+	if (!err && valid < PAGE_SIZE)
+		memset(dst + valid, 0, PAGE_SIZE - valid);
+	kunmap_local(dst);
+	if (err)
+		goto out_unlock;
+
+	flush_dcache_folio(folio);
+	folio_mark_uptodate(folio);
+out_unlock:
+	folio_unlock(folio);
+	return err;
 }
 
