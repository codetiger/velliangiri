 #define HFSPLUS_VOL_SOFTLOCK		(1 << 15)
 #define HFSPLUS_VOL_UNUSED_NODE_FIX	(1 << 31)
+
+/* HFS+ Journal structures */
+#define HFSPLUS_JIB_IN_FS		(1 << 0)
+#define HFSPLUS_JIB_NEED_INIT		(1 << 1)
+
+struct hfsplus_journal_info_block {
+	__be32 flags;
+	__be32 device_signature[8];
+	__be64 offset;
+	__be64 size;
+	__be32 reserved[32];
+} __packed;
+
+#define HFSPLUS_JOURNAL_MAGIC		0x4a4e4c78
+#define HFSPLUS_JOURNAL_ENDIAN		0x12345678
+
+struct hfsplus_journal_header {
+	__le32 magic;
+	__le32 endian;
+	__le64 start;
+	__le64 end;
+	__le64 size;
+	__le32 blhdr_size;
+	__le32 checksum;
+	__le32 jhdr_size;
+	__le32 sequence_num;
+} __packed;
+
+struct hfsplus_block_info {
+	__le64 bnum;
+	__le32 bsize;
+	__le32 next;
+} __packed;
 
+struct hfsplus_block_list_header {
+	__le16 max_blocks;
+	__le16 num_blocks;
+	__le32 bytes_used;
+	__le32 checksum;
+	__le32 flags;
+	struct hfsplus_block_info binfo[];
+} __packed;
+
 /* HFS+ BTree node descriptor */
 struct hfs_bnode_desc {
 	__be32 next;
