+
+static int hfsplus_jnl_io(struct super_block *sb, u64 byte_off,
+			  struct page *page, unsigned int len, blk_opf_t opf)
+{
+	struct hfsplus_sb_info *sbi = HFSPLUS_SB(sb);
+	struct bio *bio;
+	int ret;
+
+	bio = bio_alloc(sb->s_bdev, 1, opf, GFP_NOIO);
+	bio->bi_iter.bi_sector = sbi->part_start +
+				 (byte_off >> HFSPLUS_SECTOR_SHIFT);
+	if (bio_add_page(bio, page, len, 0) != len) {
+		bio_put(bio);
+		return -EIO;
+	}
+	ret = submit_bio_wait(bio);
+	bio_put(bio);
+	return ret < 0 ? ret : 0;
+}
+
+static u32 hfsplus_jnl_cksum(const u8 *ptr, unsigned int len)
+{
+	u32 cksum = 0;
+	unsigned int i;
+
+	for (i = 0; i < len; i++)
+		cksum = (cksum << 8) ^ (cksum + ptr[i]);
+	return ~cksum;
+}
+
+static int hfsplus_handle_journal(struct super_block *sb, bool allow_write,
+				  bool allow_replay)
+{
+	struct hfsplus_sb_info *sbi = HFSPLUS_SB(sb);
+	struct hfsplus_vh *vhdr = sbi->s_vhdr;
+	struct page *page_hdr = NULL, *page_jnl = NULL, *page_disk = NULL;
+	struct hfsplus_journal_info_block *jib;
+	struct hfsplus_journal_header *jhdr;
+	u32 jib_block, jib_flags, blhdr_size, jhdr_size, saved_cksum, calc_cksum;
+	u64 total_bytes, jib_off, j_off, j_size, start, end, size, pos;
+	unsigned int replayed = 0, dirty_blocks = 0, max_steps, steps = 0;
+	int err = -EINVAL;
+
+	if (!(vhdr->attributes & cpu_to_be32(HFSPLUS_VOL_JOURNALED)))
+		return 0;
+
+	jib_block = be32_to_cpu((__force __be32)vhdr->reserved);
+	if (!jib_block || jib_block >= sbi->total_blocks)
+		return -EINVAL;
+
+	total_bytes = (u64)sbi->total_blocks << sbi->alloc_blksz_shift;
+	jib_off = (u64)jib_block << sbi->alloc_blksz_shift;
+	if (jib_off + PAGE_SIZE > total_bytes)
+		return -EINVAL;
+
+	page_hdr = alloc_page(GFP_KERNEL);
+	page_jnl = alloc_page(GFP_KERNEL);
+	page_disk = alloc_page(GFP_KERNEL);
+	if (!page_hdr || !page_jnl || !page_disk) {
+		err = -ENOMEM;
+		goto out;
+	}
+
+	err = hfsplus_jnl_io(sb, jib_off, page_hdr, PAGE_SIZE, REQ_OP_READ);
+	if (err)
+		goto out;
+
+	jib = page_address(page_hdr);
+	jib_flags = be32_to_cpu(jib->flags);
+	if (!(jib_flags & HFSPLUS_JIB_IN_FS) ||
+	    (jib_flags & HFSPLUS_JIB_NEED_INIT)) {
+		err = -EINVAL;
+		goto out;
+	}
+
+	j_off = be64_to_cpu(jib->offset);
+	j_size = be64_to_cpu(jib->size);
+	if (!j_off || (j_off & (PAGE_SIZE - 1)) || j_size < 2 * PAGE_SIZE ||
+	    j_off + j_size > total_bytes) {
+		err = -EINVAL;
+		goto out;
+	}
 
+	err = hfsplus_jnl_io(sb, j_off, page_hdr, PAGE_SIZE, REQ_OP_READ);
+	if (err)
+		goto out;
+
+	jhdr = page_address(page_hdr);
+	if (le32_to_cpu(jhdr->magic) != HFSPLUS_JOURNAL_MAGIC ||
+	    le32_to_cpu(jhdr->endian) != HFSPLUS_JOURNAL_ENDIAN) {
+		err = -EINVAL;
+		goto out;
+	}
+
+	start = le64_to_cpu(jhdr->start);
+	end = le64_to_cpu(jhdr->end);
+	size = le64_to_cpu(jhdr->size);
+	blhdr_size = le32_to_cpu(jhdr->blhdr_size);
+	jhdr_size = le32_to_cpu(jhdr->jhdr_size);
+	saved_cksum = le32_to_cpu(jhdr->checksum);
+
+	if (jhdr_size != PAGE_SIZE || blhdr_size != PAGE_SIZE ||
+	    size != j_size || start < jhdr_size || start >= size ||
+	    end < jhdr_size || end >= size ||
+	    (start & (jhdr_size - 1)) || (end & (jhdr_size - 1))) {
+		err = -EINVAL;
+		goto out;
+	}
+
+	jhdr->checksum = 0;
+	calc_cksum = hfsplus_jnl_cksum((const u8 *)jhdr,
+			offsetof(struct hfsplus_journal_header, sequence_num));
+	jhdr->checksum = cpu_to_le32(saved_cksum);
+	if (calc_cksum != saved_cksum) {
+		err = -EINVAL;
+		goto out;
+	}
+
+	pos = start;
+	max_steps = size >> PAGE_SHIFT;
+	while (pos != end) {
+		struct hfsplus_block_list_header *blhdr;
+		u16 num_blocks, i;
+		u32 bytes_used;
+		u64 data_pos;
+
+		if (++steps > max_steps) {
+			err = -EINVAL;
+			goto out;
+		}
+
+		err = hfsplus_jnl_io(sb, j_off + pos, page_hdr, jhdr_size,
+				     REQ_OP_READ);
+		if (err)
+			goto out;
+
+		blhdr = page_address(page_hdr);
+		saved_cksum = le32_to_cpu(blhdr->checksum);
+		blhdr->checksum = 0;
+		calc_cksum = hfsplus_jnl_cksum((const u8 *)blhdr, 32);
+		blhdr->checksum = cpu_to_le32(saved_cksum);
+		if (calc_cksum != saved_cksum) {
+			err = -EINVAL;
+			goto out;
+		}
+
+		num_blocks = le16_to_cpu(blhdr->num_blocks);
+		bytes_used = le32_to_cpu(blhdr->bytes_used);
+		if (num_blocks < 1 ||
+		    (u32)(num_blocks + 1) * sizeof(struct hfsplus_block_info) >
+		    blhdr_size ||
+		    bytes_used < blhdr_size ||
+		    (bytes_used & (jhdr_size - 1)) ||
+		    bytes_used > size - jhdr_size) {
+			err = -EINVAL;
+			goto out;
+		}
+
+		data_pos = pos + blhdr_size;
+		if (data_pos >= size)
+			data_pos -= size - jhdr_size;
+
+		for (i = 1; i < num_blocks; i++) {
+			u64 bnum = le64_to_cpu(blhdr->binfo[i].bnum);
+			u32 bsize = le32_to_cpu(blhdr->binfo[i].bsize);
+			u32 sub;
+
+			if (!bsize || (bsize & (jhdr_size - 1)) ||
+			    bsize > size - jhdr_size) {
+				err = -EINVAL;
+				goto out;
+			}
+
+			for (sub = 0; sub < bsize; sub += jhdr_size) {
+				if (bnum != ~0ULL) {
+					u64 disk_off = (bnum << PAGE_SHIFT) + sub;
+
+					if (disk_off + jhdr_size > total_bytes) {
+						err = -EINVAL;
+						goto out;
+					}
+					err = hfsplus_jnl_io(sb,
+							j_off + data_pos,
+							page_jnl, jhdr_size,
+							REQ_OP_READ);
+					if (err)
+						goto out;
+					err = hfsplus_jnl_io(sb, disk_off,
+							page_disk, jhdr_size,
+							REQ_OP_READ);
+					if (err)
+						goto out;
+
+					if (memcmp(page_address(page_jnl),
+						   page_address(page_disk),
+						   jhdr_size)) {
+						dirty_blocks++;
+						if (allow_write && allow_replay) {
+							err = hfsplus_jnl_io(sb,
+								disk_off,
+								page_jnl,
+								jhdr_size,
+								REQ_OP_WRITE |
+								REQ_SYNC);
+							if (err)
+								goto out;
+							if (disk_off == 0)
+								memcpy(sbi->s_vhdr_buf,
+								       page_address(page_jnl),
+								       hfsplus_min_io_size(sb));
+							replayed++;
+						}
+					}
+				}
+				data_pos += jhdr_size;
+				if (data_pos >= size)
+					data_pos -= size - jhdr_size;
+			}
+		}
+
+		pos += bytes_used;
+		if (pos >= size)
+			pos -= size - jhdr_size;
+	}
+
+	if (dirty_blocks && (!allow_write || !allow_replay)) {
+		err = -EROFS;
+		goto out;
+	}
+
+	if (allow_write && start != end) {
+		err = hfsplus_jnl_io(sb, j_off, page_hdr, jhdr_size,
+				     REQ_OP_READ);
+		if (err)
+			goto out;
+		jhdr = page_address(page_hdr);
+		jhdr->start = jhdr->end;
+		jhdr->checksum = 0;
+		calc_cksum = hfsplus_jnl_cksum((const u8 *)jhdr,
+			offsetof(struct hfsplus_journal_header, sequence_num));
+		jhdr->checksum = cpu_to_le32(calc_cksum);
+		err = hfsplus_jnl_io(sb, j_off, page_hdr, jhdr_size,
+				     REQ_OP_WRITE | REQ_SYNC);
+		if (err)
+			goto out;
+		pr_info("journal verified (%u blocks replayed)\n", replayed);
+	}
+
+	vhdr->attributes |= cpu_to_be32(HFSPLUS_VOL_UNMNT);
+	vhdr->attributes &= cpu_to_be32(~HFSPLUS_VOL_INCNSTNT);
+	err = 0;
+out:
+	if (page_disk)
+		__free_page(page_disk);
+	if (page_jnl)
+		__free_page(page_jnl);
