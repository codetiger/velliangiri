+static int hfsplus_crypt_writepage(struct folio *folio,
+				   struct writeback_control *wbc, void *data)
+{
+	struct inode *inode = folio->mapping->host;
+	struct hfsplus_inode_info *hip = HFSPLUS_I(inode);
+	struct super_block *sb = inode->i_sb;
+	struct buffer_head *bh = folio_buffers(folio);
+	struct buffer_head map_bh = {};
+	loff_t i_size = i_size_read(inode);
+	loff_t pos = folio_pos(folio);
+	sector_t blocknr;
+	const u8 *src;
+	int err;
+
+	if (pos >= i_size) {
+		if (bh)
+			clear_buffer_dirty(bh);
+		folio_unlock(folio);
+		return 0;
+	}
+
+	if (pos + PAGE_SIZE > i_size)
+		folio_zero_segment(folio, i_size - pos, PAGE_SIZE);
+
+	if (bh && buffer_mapped(bh)) {
+		blocknr = bh->b_blocknr;
+	} else {
+		map_bh.b_size = PAGE_SIZE;
+		err = hfsplus_get_block(inode, folio->index, &map_bh, 1);
+		if (err || !buffer_mapped(&map_bh)) {
+			folio_redirty_for_writepage(wbc, folio);
+			folio_unlock(folio);
+			return err ? err : -EIO;
+		}
+		blocknr = map_bh.b_blocknr;
+		if (bh) {
+			bh->b_bdev = map_bh.b_bdev;
+			bh->b_blocknr = blocknr;
+			set_buffer_mapped(bh);
+		}
+	}
+
+	if (bh) {
+		clear_buffer_dirty(bh);
+		set_buffer_uptodate(bh);
+	}
+
+	folio_start_writeback(folio);
+	src = kmap_local_folio(folio, 0);
+	err = s5l8947x_file_block_encrypt(sb->s_bdev, blocknr, hip->file_key,
+					  hip->file_iv_key, pos, src);
+	kunmap_local(src);
+	folio_unlock(folio);
+	folio_end_writeback(folio);
+	if (err)
+		mapping_set_error(folio->mapping, err);
+	return err;
 }
 
 static int hfsplus_writepages(struct address_space *mapping,
 			      struct writeback_control *wbc)
 {
+	struct inode *inode = mapping->host;
+	struct hfsplus_inode_info *hip = HFSPLUS_I(inode);
+
+	if (hip->file_crypt == 1 && inode->i_sb->s_blocksize == PAGE_SIZE)
+		return write_cache_pages(mapping, wbc, hfsplus_crypt_writepage,
+					 NULL);
 	return mpage_writepages(mapping, wbc, hfsplus_get_block);
 }
 
