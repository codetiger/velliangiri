# SPDX-License-Identifier: GPL-2.0-only
# Kernel configuration fragment for S5L8947X (j33iap)

# ---- Platform, CPU, Interrupts, Timer & Watchdog ---------------------------
CONFIG_ARCH_MULTI_V7=y
CONFIG_ARCH_APPLE_S5L=y
CONFIG_APPLE_AIC1=y
CONFIG_APPLE_S5L_WDT_CLKEVT=y
CONFIG_APPLE_S5L_WATCHDOG=y
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_CORE=y
CONFIG_WATCHDOG_SYSFS=y

# Single Cortex-A9 core with 512 KB PL310 L2 cache, VFPv3-D32 & ARM NEON
# CONFIG_SMP is not set
CONFIG_NR_CPUS=1
CONFIG_VFP=y
CONFIG_VFPv3=y
CONFIG_NEON=y
CONFIG_KERNEL_MODE_NEON=y
CONFIG_CACHE_L2X0=y
CONFIG_PL310_ERRATA_769419=y
# CONFIG_VMAP_STACK is not set
# CONFIG_ARM_PAN is not set

# Appended DTB and kernel diagnostics
CONFIG_ARM_APPENDED_DTB=y
CONFIG_ARM_ATAG_DTB_COMPAT=y
# CONFIG_ARM_ATAG_DTB_COMPAT_CMDLINE_FROM_BOOTLOADER is not set
CONFIG_PRINTK_TIME=y
CONFIG_DEBUG_KERNEL=y
CONFIG_PANIC_TIMEOUT=10
CONFIG_MAGIC_SYSRQ=y
# CONFIG_SUSPEND is not set
# CONFIG_HIBERNATION is not set

# Interactive latency on the single core: voluntary preemption points in long
# kernel paths (NAND, FTL, HFS+, AES) and a 4 ms tick, so input and display
# stay responsive while a CPU-bound task runs
# CONFIG_PREEMPT_NONE is not set
CONFIG_PREEMPT_VOLUNTARY=y
# CONFIG_HZ_100 is not set
CONFIG_HZ_250=y

# Compressed swap in RAM (zram, lz4): the root filesystem lives in RAM and
# there is no swap device on NAND
CONFIG_SWAP=y
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_DEF_COMP_LZ4=y

# ---- Compression, Initramfs & Core Filesystems -----------------------------
# Single-stream XZ compression over kernel + uncompressed initramfs
# CONFIG_KERNEL_GZIP is not set
# CONFIG_KERNEL_BZIP2 is not set
# CONFIG_KERNEL_LZMA is not set
CONFIG_KERNEL_XZ=y
# CONFIG_KERNEL_LZO is not set
# CONFIG_KERNEL_LZ4 is not set
# CONFIG_KERNEL_ZSTD is not set

CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_BLK_DEV_RAM=y
CONFIG_BLK_DEV_RAM_COUNT=1
CONFIG_BLK_DEV_RAM_SIZE=262144
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_OVERLAY_FS=y
CONFIG_CONFIGFS_FS=y
CONFIG_UNIX98_PTYS=y

# CONFIG_MMC is not set
# CONFIG_ATA is not set
# CONFIG_SCSI is not set

# ---- Clocks, CPUFreq, GPIO/Pinctrl, I2C & Dialog D1815 PMU -----------------
CONFIG_S5L8940X_PMGR_CLK=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_STAT=y
CONFIG_CPU_FREQ_DEFAULT_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_USERSPACE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_CONSERVATIVE=y
CONFIG_ARM_S5L8947X_CPUFREQ=y
CONFIG_PINCTRL_S5L8940X_GPIO=y
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_S5L8940X=y
CONFIG_REGMAP_I2C=y
CONFIG_MFD_APPLE_PMU_I2C=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_APPLE_PMU_PWRSW=y
CONFIG_RTC_DRV_APPLE_PMU=y
CONFIG_HWMON=y
CONFIG_SENSORS_APPLE_PMU=y
CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_CPU_THERMAL=y

# ---- UART, System / IR Remote MCU (UART1) & BCM4334 Bluetooth (UART2) ------
CONFIG_SERIAL_SAMSUNG=y
CONFIG_SERIAL_SAMSUNG_CONSOLE=y
CONFIG_SERIAL_SAMSUNG_UARTS=5
CONFIG_SERIAL_EARLYCON=y
CONFIG_SERIAL_DEV_BUS=y
CONFIG_SERIAL_DEV_CTRL_TTYPORT=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_MISC=y
CONFIG_INPUT_S5L8947X_MCU=y
# uinput: feed key/pointer events from userspace for bring-up without a keyboard
CONFIG_INPUT_UINPUT=y
CONFIG_BT=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_BCM=y
# Bluetooth keyboards: HIDP for Classic (BR/EDR) devices, UHID for the
# BlueZ HID-over-GATT profile used by Bluetooth LE keyboards
CONFIG_BT_HIDP=y
CONFIG_UHID=y

# ---- Display Pipe (rgbout, HDMI 1.4, M2M Scaler) & Framebuffer Console -----
CONFIG_FB=y
CONFIG_FB_DEVICE=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
# CONFIG_FONT_8x8 is not set
# CONFIG_LOGO is not set
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_S5L8947X=y

# ---- Central DMA, Hardware/NEON Crypto, Managed NAND (FMI0 + FTL) & HFS+ ----
CONFIG_DMADEVICES=y
CONFIG_S5L8947X_CDMA=y
CONFIG_CRYPTO_HW=y
CONFIG_CRYPTO_DEV_S5L8947X_AES=y
CONFIG_CRYPTO_DEV_S5L8947X_SHA=y
CONFIG_CRYPTO_SIMD=y
CONFIG_CRYPTO_SHA1_ARM=y
CONFIG_CRYPTO_SHA1_ARM_NEON=y
CONFIG_CRYPTO_SHA256_ARM=y
CONFIG_CRYPTO_SHA512_ARM=y
CONFIG_CRYPTO_AES_ARM=y
CONFIG_CRYPTO_AES_ARM_BS=y
CONFIG_CRYPTO_BLAKE2S_ARM=y
CONFIG_CRYPTO_BLAKE2B_NEON=y
CONFIG_CRYPTO_CHACHA20=y
CONFIG_CRYPTO_POLY1305=y
CONFIG_CRYPTO_CHACHA20POLY1305=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_MTD=y
CONFIG_MTD_S5L8947X_FMI=y
CONFIG_MTD_S5L8947X_FTL=y
CONFIG_HFSPLUS_FS=y

# ---- Audio (I2S0 to HDMI + S/PDIF Optical, ALSA PCM) -----------------------
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_TIMER=y
CONFIG_SND_PCM=y
CONFIG_SND_ARM=y
CONFIG_SND_S5L8947X_AUDIO=y

# ---- Networking, 10/100 Fast Ethernet (s5l_fe), Netconsole & NFSv3 ---------
CONFIG_NET=y
CONFIG_INET=y
CONFIG_NET_VENDOR_APPLE=y
CONFIG_S5L_FE=y
CONFIG_PHYLIB=y
CONFIG_MDIO_BUS=y
CONFIG_OF_MDIO=y
CONFIG_SMSC_PHY=y
CONFIG_NETCONSOLE=y
CONFIG_NETCONSOLE_DYNAMIC=y
CONFIG_NFS_FS=y
CONFIG_NFS_V3=y
CONFIG_NFS_V3_ACL=y
# CONFIG_NFS_V4 is not set
CONFIG_SUNRPC=y
CONFIG_LOCKD=y
# CONFIG_ROOT_NFS is not set

# ---- USB 2.0 OTG Gadget (dwc2) & EHCI HSIC Host (BCM4334 Wi-Fi) ------------
CONFIG_GENERIC_PHY=y
CONFIG_PHY_APPLE_S5L_USB=y
CONFIG_USB=y
CONFIG_USB_SUPPORT=y
CONFIG_USB_COMMON=y
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_PERIPHERAL=y
# CONFIG_USB_DWC2_DUAL_ROLE is not set
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_U_SERIAL=y
CONFIG_USB_U_ETHER=y
CONFIG_USB_F_ACM=y
CONFIG_USB_F_ECM=y
CONFIG_USB_CDC_COMPOSITE=y
# CONFIG_USB_G_SERIAL is not set
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_ROOT_HUB_TT=y
CONFIG_USB_EHCI_HCD_PLATFORM=y
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_CFG80211_WEXT=y
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_BROADCOM=y
CONFIG_BRCMFMAC=y
CONFIG_BRCMFMAC_USB=y
CONFIG_CRC32=y

# ---- PowerVR SGX543 GPU Power/Clock Domain & Telemetry (/dev/sgx0) ---------
CONFIG_APPLE_S5L8947X_SGX=y

# ---- M2 scaler / colour-space converter (V4L2 memory-to-memory) -----------
# Media support is limited to platform drivers by the filter
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_SUPPORT_FILTER=y
CONFIG_MEDIA_PLATFORM_SUPPORT=y
CONFIG_VIDEO_DEV=y
CONFIG_MEDIA_PLATFORM_DRIVERS=y
CONFIG_V4L_MEM2MEM_DRIVERS=y
CONFIG_VIDEO_S5L8947X_M2SC=y
CONFIG_VIDEO_S5L8947X_JPEG=y

# ---- VXD video decoder power, firmware upload and handshake (experimental) --
CONFIG_APPLE_S5L8947X_VXD=y

# ---- IOP coprocessor power, firmware load and CPU start (experimental) ------
CONFIG_APPLE_S5L8947X_IOP=y
