# SPDX-License-Identifier: GPL-2.0-only
# Kernel configuration fragment for S5L8947X (j33iap)

CONFIG_ARCH_MULTI_V7=y
CONFIG_ARCH_APPLE_S5L=y
CONFIG_APPLE_AIC1=y
CONFIG_APPLE_S5L_WDT_CLKEVT=y
CONFIG_APPLE_S5L_WATCHDOG=y

# Single-stream XZ compression over kernel + uncompressed initramfs
# CONFIG_KERNEL_GZIP is not set
# CONFIG_KERNEL_BZIP2 is not set
# CONFIG_KERNEL_LZMA is not set
CONFIG_KERNEL_XZ=y
# CONFIG_KERNEL_LZO is not set
# CONFIG_KERNEL_LZ4 is not set
# CONFIG_KERNEL_ZSTD is not set

# S5L8947X has a single Cortex-A9 core
# CONFIG_SMP is not set
CONFIG_NR_CPUS=1
CONFIG_CACHE_L2X0=y
CONFIG_PL310_ERRATA_769419=y
# CONFIG_VMAP_STACK is not set
# CONFIG_ARM_PAN is not set

CONFIG_SERIAL_SAMSUNG=y
CONFIG_SERIAL_SAMSUNG_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y

# 720p HDMI scanout via simple-framebuffer and fbcon
CONFIG_FB=y
CONFIG_FB_DEVICE=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
# CONFIG_FONT_8x8 is not set
# CONFIG_LOGO is not set
# CONFIG_DRM is not set

CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_BLK_DEV_RAM=y
CONFIG_BLK_DEV_RAM_COUNT=1
CONFIG_BLK_DEV_RAM_SIZE=262144
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_OVERLAY_FS=y

CONFIG_ARM_APPENDED_DTB=y
CONFIG_ARM_ATAG_DTB_COMPAT=y
# CONFIG_ARM_ATAG_DTB_COMPAT_CMDLINE_FROM_BOOTLOADER is not set

CONFIG_PRINTK_TIME=y
CONFIG_DEBUG_KERNEL=y
CONFIG_PANIC_TIMEOUT=10
CONFIG_MAGIC_SYSRQ=y

# CONFIG_SUSPEND is not set
# CONFIG_HIBERNATION is not set

# Hardware watchdog (/dev/watchdog)
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_CORE=y
CONFIG_WATCHDOG_SYSFS=y

# UDP netconsole over eth0
CONFIG_NETCONSOLE=y
CONFIG_NETCONSOLE_DYNAMIC=y
CONFIG_CONFIGFS_FS=y

# USB 2.0 OTG PHY + dwc2 peripheral (CDC-ECM + CDC-ACM)
CONFIG_GENERIC_PHY=y
CONFIG_PHY_APPLE_S5L_USB=y
CONFIG_USB=y
CONFIG_USB_SUPPORT=y
CONFIG_USB_COMMON=y
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_PERIPHERAL=y
# CONFIG_USB_DWC2_DUAL_ROLE is not set
CONFIG_USB_GADGET=y
CONFIG_NET=y
CONFIG_INET=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_U_SERIAL=y
CONFIG_USB_U_ETHER=y
CONFIG_USB_F_ACM=y
CONFIG_USB_F_ECM=y
CONFIG_USB_CDC_COMPOSITE=y
# CONFIG_USB_G_SERIAL is not set

CONFIG_UNIX98_PTYS=y
CONFIG_NFS_FS=y
CONFIG_NFS_V3=y
CONFIG_NFS_V3_ACL=y
# CONFIG_NFS_V4 is not set
CONFIG_SUNRPC=y
CONFIG_LOCKD=y
# CONFIG_ROOT_NFS is not set

# CONFIG_MMC is not set
# CONFIG_ATA is not set
# CONFIG_SCSI is not set

# 10/100 Fast Ethernet MAC (s5l_fe) + SMSC LAN8742 PHY
CONFIG_NET_VENDOR_APPLE=y
CONFIG_S5L_FE=y
CONFIG_PHYLIB=y
CONFIG_MDIO_BUS=y
CONFIG_OF_MDIO=y
CONFIG_SMSC_PHY=y

# Clocks, CPUFreq, GPIO/Pinctrl, I2C, and Dialog D1815 PMU
CONFIG_S5L8940X_PMGR_CLK=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_STAT=y
CONFIG_CPU_FREQ_DEFAULT_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_USERSPACE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_CONSERVATIVE=y
CONFIG_ARM_S5L8947X_CPUFREQ=y
CONFIG_PINCTRL_S5L8940X_GPIO=y
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_S5L8940X=y
CONFIG_REGMAP_I2C=y
CONFIG_MFD_APPLE_PMU_I2C=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_APPLE_PMU_PWRSW=y

# System / IR remote MCU (UART1) and BCM4334 Bluetooth (UART2)
CONFIG_SERIAL_DEV_BUS=y
CONFIG_SERIAL_DEV_CTRL_TTYPORT=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_MISC=y
CONFIG_INPUT_S5L8947X_MCU=y
CONFIG_BT=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_BCM=y

# BCM4334 Wi-Fi: EHCI host port 2 (HSIC), brcmfmac over USB. Firmware
# (brcm/brcmfmac4334.bin) and NVRAM (brcm/brcmfmac4334.txt) are supplied
# by the user under /lib/firmware at runtime.
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_ROOT_HUB_TT=y
CONFIG_USB_EHCI_HCD_PLATFORM=y
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_CFG80211_WEXT=y
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_BROADCOM=y
CONFIG_BRCMFMAC=y
CONFIG_BRCMFMAC_USB=y
CONFIG_CRC32=y

# Display pipe (rgbout + out + HDMI 1.4 + M2M scaler)
CONFIG_FB_S5L8947X_DISPLAY=y

# Central DMA (dmaengine provider for audio and NAND, later crypto)
CONFIG_DMADEVICES=y
CONFIG_S5L8947X_CDMA=y

# Flash memory interface: read-only MTD on the managed NAND (/dev/mtd0).
CONFIG_MTD=y
CONFIG_MTD_S5L8947X_FMI=y

# Translation layer and volume map on top of it (/dev/nand0, /dev/nand0pN),
# and HFS+ to mount the system volume read-only.
CONFIG_MTD_S5L8947X_FTL=y
CONFIG_HFSPLUS_FS=y

# AES engine in the central DMA block (ecb/cbc(aes), hardware keys in-kernel)
CONFIG_CRYPTO_HW=y
CONFIG_CRYPTO_DEV_S5L8947X_AES=y

# Audio (I2S0 to HDMI + S/PDIF optical, ALSA PCM)
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_TIMER=y
CONFIG_SND_PCM=y
CONFIG_SND_ARM=y
CONFIG_SND_S5L8947X_AUDIO=y

# 5. PowerVR SGX543 GPU Power/Clock Domain & Telemetry (/dev/sgx0)
CONFIG_APPLE_S5L8947X_SGX=y
