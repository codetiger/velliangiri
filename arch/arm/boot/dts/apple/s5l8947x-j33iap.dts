/*
 * S5L8947X TV Platform (j33iap) Board Device Tree
 */

/dts-v1/;

#include <dt-bindings/thermal/thermal.h>
#include "s5l8947x.dtsi"

/ {
	model = "S5L8947X j33iap";
	compatible = "apple,j33iap", "apple,s5l8947x", "apple,s5l8940x";

	aliases {
		serial0 = &uart0;
		serial1 = &uart1;
		serial2 = &uart2;
		ethernet0 = &eth0;
	};

	chosen {
		bootargs = "earlycon=s3c6400,0x32500000 keep_bootcon console=tty0 root=/dev/ram0 rw rootwait panic=10 loglevel=8 ignore_loglevel g_cdc.host_addr=02:10:5a:33:00:01 g_cdc.dev_addr=02:10:5a:33:00:02 netconsole=6666@10.55.0.2/eth0,6666@255.255.255.255/ff:ff:ff:ff:ff:ff rdinit=/init";
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x80000000 0x1f000000>;
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		fb_region: framebuffer@9e400000 {
			reg = <0x9e400000 0x800000>;
			no-map;
		};
	};

	/* 1080p30 boot splash scanned out by the boot loader */
	framebuffer0: framebuffer@9e400000 {
		compatible = "simple-framebuffer";
		reg = <0x9e400000 0x7e9000>;
		width = <1920>;
		height = <1080>;
		stride = <7680>;
		format = "a8r8g8b8";
		memory-region = <&fb_region>;
		status = "okay";
	};
};

&gpio {
	status = "okay";

	/* The boot loader leaves RTS (pin 20) as a GPIO held high */
	bt_uart_pins: bt-uart-pins {
		pins = "PIN18", "PIN19", "PIN20", "PIN21";
		apple,peripheral-function = <2>;
	};
};

/*
 * BCM4334 Wi-Fi on EHCI port 2 (HSIC). The host PHY raises REG_ON, then
 * signals host ready (GPIO 113) and waits for device ready (GPIO 128)
 * before the port is scanned.
 */
&usb_phy {
	hsic-supply = <&wlan_reg_on>;
	host-ready-gpios = <&gpio 113 GPIO_ACTIVE_HIGH>;
	device-ready-gpios = <&gpio 128 GPIO_ACTIVE_HIGH>;
};

&usb_ehci {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	/*
	 * The firmware does not start without a MAC address in its NVRAM.
	 * Its built-in regulatory table takes ISO 3166 codes as they are, so
	 * a country set through cfg80211 reaches it unmapped.
	 */
	wifi@2 {
		compatible = "usba5c,bd1a";
		reg = <2>;
		local-mac-address = [02 10 5a 33 00 44];
		brcm,ccode-map-trivial;
	};
};

&i2c0 {
	status = "okay";

	pmu: pmu@74 {
		compatible = "apple,pmu-d1815", "apple,d1815-pmu", "apple,pmu-i2c";
		reg = <0x74>;
		/* Event interrupt: active low on SoC GPIO 109 */
		interrupt-parent = <&gpio>;
		interrupts = <109 IRQ_TYPE_LEVEL_LOW>;
		interrupt-controller;
		#interrupt-cells = <2>;
		#address-cells = <1>;
		#size-cells = <0>;

		/* D1815 GPIO 8 (reg 0x58, bit 1): SMSC LAN8742 Ethernet PHY nRST */
		eth_phy_reset: eth_phy_reset@58 {
			compatible = "apple,pmu-pwrsw", "apple,pmu-power-switch";
			reg = <0x58>;
			mask = <0x02>;
			enable = <0x02>;
		};

		/* D1815 GPIO 7 (reg 0x57, bit 1): BCM4334 Wi-Fi REG_ON */
		wlan_reg_on: wlan_reg_on@57 {
			compatible = "apple,pmu-pwrsw", "apple,pmu-power-switch";
			reg = <0x57>;
			mask = <0x02>;
			enable = <0x02>;
		};

		/* Seconds counter at 0x4c, alarm event 32 */
		rtc {
			compatible = "apple,pmu-d1815-rtc";
			interrupts-extended = <&pmu 32 IRQ_TYPE_EDGE_RISING>;
		};

		/* ADC: thermistors on channels 11..14 and the junction; done = event 13 */
		pmu_adc: adc {
			compatible = "apple,pmu-d1815-adc";
			interrupts-extended = <&pmu 13 IRQ_TYPE_EDGE_RISING>;
			#thermal-sensor-cells = <1>;
			apple,thermistor-labels = "SoC", "Wi-Fi", "Power supply", "NAND";
		};
	};
};

&i2c2 {
	status = "okay";
};

&eth0 {
	status = "okay";
	local-mac-address = [02 10 5a 33 00 ee];
	phy-mode = "mii";
	phy-handle = <&ethphy0>;
	phy-supply = <&eth_phy_reset>;

	mdio {
		#address-cells = <1>;
		#size-cells = <0>;

		ethphy0: ethernet-phy@0 {
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <0>;
		};
	};
};

&uart1 {
	status = "okay";

	/* TI MSP430 system / IR remote MCU */
	mcu {
		compatible = "apple,j33-mcu";
		current-speed = <250000>;
	};
};

&uart2 {
	status = "okay";

	pinctrl-names = "default";
	pinctrl-0 = <&bt_uart_pins>;

	bluetooth {
		compatible = "brcm,bcm4334-bt";
		shutdown-gpios = <&gpio 104 GPIO_ACTIVE_HIGH>;
		device-wakeup-gpios = <&gpio 105 GPIO_ACTIVE_HIGH>;
		/* Host wake: D1815 GPIO 6 (reg 0x56, input), PMU event 22 */
		interrupts-extended = <&pmu 22 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "host-wakeup";
		/*
		 * The UART clocks are about 51.3 MHz and 24 MHz with integer
		 * divisors only, so the stock 3 Mbaud is out of reach; 51.3 MHz / 32
		 * is matched by the controller within about 0.2%.
		 */
		max-speed = <1603125>;
	};
};

/* Display pipe (rgbout + out + HDMI + M2M scaler) */
&display_pipe {
	status = "okay";
};

/* Audio (I2S0 to HDMI, S/PDIF to optical) */
&audio0 {
	status = "okay";
};

/* AES engine (memory to memory through CDMA channels 1 and 2) */
&aes {
	status = "okay";
};

&sha {
	status = "okay";
};

/* NAND: one managed NAND package on FMI0, CE0; FMI1 is unpopulated */
&fmi0 {
	status = "okay";
};

/* PowerVR SGX543 GPU; the microkernel is provisioned from the System volume */
&sgx0 {
	status = "okay";
};

/* VXD decoder: power, firmware upload and handshake (no decode interface yet) */
&vxd {
	status = "okay";
};

/ {
	thermal-zones {
		/* Board thermistor next to the SoC (temp1) */
		soc-thermal {
			polling-delay-passive = <1000>;
			polling-delay = <5000>;
			thermal-sensors = <&pmu_adc 0>;

			trips {
				soc_passive: soc-passive {
					temperature = <70000>;
					hysteresis = <5000>;
					type = "passive";
				};

				soc-critical {
					temperature = <95000>;
					hysteresis = <2000>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&soc_passive>;
					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};
	};
};
