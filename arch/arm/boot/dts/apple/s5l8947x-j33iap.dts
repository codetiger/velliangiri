/*
 * S5L8947X TV Platform (j33iap) Board Device Tree
 */

/dts-v1/;

#include "s5l8947x.dtsi"

/ {
	model = "S5L8947X j33iap";
	compatible = "apple,j33iap", "apple,s5l8947x", "apple,s5l8940x";

	aliases {
		serial0 = &uart0;
		serial1 = &uart1;
		serial2 = &uart2;
		ethernet0 = &eth0;
	};

	chosen {
		bootargs = "earlycon=s3c6400,0x32500000 keep_bootcon console=tty0 root=/dev/ram0 rw rootwait panic=10 loglevel=8 ignore_loglevel g_cdc.host_addr=02:10:5a:33:00:01 g_cdc.dev_addr=02:10:5a:33:00:02 netconsole=6666@10.55.0.2/eth0,6666@255.255.255.255/ff:ff:ff:ff:ff:ff rdinit=/init";
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x80000000 0x1f000000>;
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		fb_region: framebuffer@9ec00000 {
			reg = <0x9ec00000 0x400000>;
			no-map;
		};
	};

	framebuffer0: framebuffer@9ec00000 {
		compatible = "simple-framebuffer";
		reg = <0x9ec00000 0x384000>;
		width = <1280>;
		height = <720>;
		stride = <5120>;
		format = "a8r8g8b8";
		memory-region = <&fb_region>;
		status = "okay";
	};

	/* BCM4334 Wi-Fi power, switched from userspace until the HSIC host is up */
	wlan_power: wlan-power {
		compatible = "regulator-output";
		vout-supply = <&wlan_reg_on>;
	};
};

&i2c0 {
	status = "okay";

	pmu: pmu@74 {
		compatible = "apple,pmu-d1815", "apple,d1815-pmu", "apple,pmu-i2c";
		reg = <0x74>;
		#address-cells = <1>;
		#size-cells = <0>;

		/* D1815 GPIO 8 (reg 0x58, bit 1): SMSC LAN8742 Ethernet PHY nRST */
		eth_phy_reset: eth_phy_reset@58 {
			compatible = "apple,pmu-pwrsw", "apple,pmu-power-switch";
			reg = <0x58>;
			mask = <0x02>;
			enable = <0x02>;
		};

		/* D1815 GPIO 7 (reg 0x57, bit 1): BCM4334 Wi-Fi REG_ON */
		wlan_reg_on: wlan_reg_on@57 {
			compatible = "apple,pmu-pwrsw", "apple,pmu-power-switch";
			reg = <0x57>;
			mask = <0x02>;
			enable = <0x02>;
		};
	};
};

&i2c2 {
	status = "okay";
};

&eth0 {
	status = "okay";
	local-mac-address = [02 10 5a 33 00 ee];
	phy-mode = "mii";
	phy-handle = <&ethphy0>;
	phy-supply = <&eth_phy_reset>;

	mdio {
		#address-cells = <1>;
		#size-cells = <0>;

		ethphy0: ethernet-phy@0 {
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <0>;
		};
	};
};

&uart1 {
	status = "okay";

	/* TI MSP430 system / IR remote MCU */
	mcu {
		compatible = "apple,j33-mcu";
		current-speed = <115200>;
	};
};

&uart2 {
	status = "okay";

	bluetooth {
		compatible = "brcm,bcm4334-bt";
	};
};

/* Display pipe (rgbout + out + HDMI + M2M scaler) */
&display_pipe {
	status = "okay";
};

/* Audio (I2S0 to HDMI + S/PDIF optical) */
&audio0 {
	status = "okay";
};

/* PowerVR SGX543 GPU (master block only; per-core registers hang the bus) */
&sgx0 {
	status = "okay";
};
