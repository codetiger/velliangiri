/*
 * S5L8947X SoC Device Tree Include
 */

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/irq.h>

/ {
	#address-cells = <1>;
	#size-cells = <1>;
	interrupt-parent = <&aic>;
	compatible = "apple,s5l8947x", "apple,s5l8940x", "apple,arm";

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu0: cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a9";
			reg = <0>;
		};
	};

	l2: cache-controller@3e000000 {
		compatible = "arm,pl310-cache";
		reg = <0x3e000000 0x1000>;
		cache-unified;
		cache-level = <2>;
		status = "disabled";
	};

	osc24m: clock-24000000 {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <24000000>;
		clock-output-names = "osc24m";
	};

	soc: soc@30000000 {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <1>;
		ranges = <0x0 0x30000000 0x10000000>;

		aic: interrupt-controller@f200000 {
			compatible = "aic,1", "apple,aic1";
			reg = <0xf200000 0x10000>;
			interrupt-controller;
			#interrupt-cells = <1>;
			#address-cells = <0>;
			apple,main-cpus = <1>;
		};

		uart0: serial@2500000 {
			compatible = "apple,s5l-uart", "samsung,s3c6400-uart";
			reg = <0x2500000 0x1000>;
			interrupts = <21>;
			clocks = <&osc24m>, <&osc24m>;
			clock-names = "uart", "clk_uart_baud0";
			status = "disabled";
		};

		wdt: timer@f103020 {
			compatible = "apple,s5l8947x-wdt", "apple,s5l8940x-wdt-timer";
			reg = <0xf103020 0x10>;
			interrupts = <4>;
			clock-frequency = <24000000>;
			status = "okay";
		};

		pmgr: power-management@f100000 {
			compatible = "apple,s5l8940x-pmgr", "syscon";
			reg = <0xf100000 0x7000>;
			status = "disabled";
		};

		i2c0: i2c@3200000 {
			compatible = "apple,s5l8947x-i2c", "apple,s5l8940x-i2c";
			reg = <0x3200000 0x1000>;
			interrupts = <18>;
			clock-frequency = <100000>;
			clocks = <&osc24m>;
			clock-names = "i2c";
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		i2c1: i2c@3300000 {
			compatible = "apple,s5l8947x-i2c", "apple,s5l8940x-i2c";
			reg = <0x3300000 0x1000>;
			interrupts = <19>;
			clock-frequency = <100000>;
			clocks = <&osc24m>;
			clock-names = "i2c";
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		i2c2: i2c@3400000 {
			compatible = "apple,s5l8947x-i2c", "apple,s5l8940x-i2c";
			reg = <0x3400000 0x1000>;
			interrupts = <20>;
			clock-frequency = <100000>;
			clocks = <&osc24m>;
			clock-names = "i2c";
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		usb_phy: phy@6000000 {
			compatible = "apple,s5l8947x-otgphy", "apple,s5l-usb-phy";
			reg = <0x6000000 0x1000>,
			      <0xf108000 0x1000>,
			      <0x6100e00 0x4>;
			#phy-cells = <1>;
			apple,clock-gates = <30 31 36>;
			apple,uotgtune1-device = <0x349>;
			apple,uotgtune2-device = <0x6ff3>;
			status = "okay";
		};

		usb0: usb@6100000 {
			compatible = "apple,s5l8940x-dwc2", "snps,dwc2";
			reg = <0x6100000 0x10000>;
			interrupts = <11>;
			phys = <&usb_phy 0>;
			phy-names = "usb2-phy";
			dr_mode = "peripheral";
			g-rx-fifo-size = <512>;
			g-np-tx-fifo-size = <128>;
			g-tx-fifo-size = <128 128 128 128 128 128 128 128>;
			status = "okay";
		};

		eth0: ethernet@b000000 {
			compatible = "apple,s5l8947x-ethernet";
			reg = <0xb000000 0x10000>;
			interrupts = <27>;
			apple,clock-gate = <79>;
			status = "disabled";
		};
	};
};
